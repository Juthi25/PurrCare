            <TextView android:id="@+id/tvTitle" style="@style/TitleText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:alpha="0.7" android:src="@drawable/ic_paw" android:tint="@color/lavender_dark" tools:ignore="UseAppTint" />
        </LinearLayout>
