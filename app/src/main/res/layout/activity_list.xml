    </LinearLayout>
    <TextView android:id="@+id/tvEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/text_gray" android:textSize="16sp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="@+id/contentArea" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@+id/contentArea" app:layout_constraintVertical_bias="0.65" />
