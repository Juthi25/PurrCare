{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "healthRecords":  { ".indexOn": ["catId"] },
        "foodSchedules":  { ".indexOn": ["catId"] },
        "reminders":      { ".indexOn": ["catId"] },
        "weightRecords":  { ".indexOn": ["catId"] },
        "expenses":       { ".indexOn": ["catId"] },
        "diary":          { ".indexOn": ["catId"] }
      }
    }
  }
}
